# W12-1: Cat-Cut billing-server の環境変数テンプレート。
# このファイルを .env にコピーして値を埋める(.env はコミットしない)。

# ------------------------------------------------------------------
# 共通
# ------------------------------------------------------------------

# W12-4: 決済プロバイダの選択("stripe" または "univapay"。省略時 stripe)
PAYMENT_PROVIDER=stripe

# ライセンス署名用 Ed25519 秘密鍵(base64)。scripts/generate-keys.mjs で生成する
LICENSE_SIGNING_KEY=

# このサーバの公開URL(例: https://billing.example.com)。決済完了後の戻り先に使う
PUBLIC_BASE_URL=

# リッスンポート(省略時 8788)
PORT=8788

# ------------------------------------------------------------------
# Stripe(PAYMENT_PROVIDER=stripe のとき必須)
# ------------------------------------------------------------------

# Stripe のシークレットキー(テスト: sk_test_... / 本番: sk_live_...)
STRIPE_SECRET_KEY=

# Stripe webhook エンドポイントの署名シークレット(whsec_...)
# ダッシュボードで webhook エンドポイント登録時に発行される
STRIPE_WEBHOOK_SECRET=

# Stripe ダッシュボードで作成した Price の ID(price_...)。金額決定後に設定する
PRICE_ID_MONTHLY=
PRICE_ID_YEARLY=
PRICE_ID_LIFETIME=

# ------------------------------------------------------------------
# W12-4: UnivaPay(PAYMENT_PROVIDER=univapay のとき必須)
# ------------------------------------------------------------------

# 管理画面で作成した「店舗」アプリトークンの JWT 部分
UNIVAPAY_APP_TOKEN=

# 同アプリトークンのシークレット(作成時にのみ表示される。機密情報)
UNIVAPAY_APP_SECRET=

# webhook URL のパスに埋め込む自前のシークレット(ランダムな英数32文字以上を推奨。
# 例: openssl rand -hex 32 で生成)。UnivaPay管理画面には
# https://<デプロイ先>/webhook/univapay/<この値> を送信先URLとして登録する
UNIVAPAY_WEBHOOK_SECRET=

# 管理画面のリンクフォーム設定で発行されるフォームURL
# (例: https://checkout.univapay.com/forms/<フォームID>)
UNIVAPAY_LINK_FORM_BASE=

# 各プランの課金額(JPY・整数)。金額決定後に設定する
UNIVAPAY_AMOUNT_MONTHLY=
UNIVAPAY_AMOUNT_YEARLY=
UNIVAPAY_AMOUNT_LIFETIME=
